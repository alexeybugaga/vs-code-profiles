// Настройки поверх shared/ и layers/web/.
{
  // ESLint по умолчанию не проверяет .svelte-файлы
  "eslint.validate": ["svelte"],

  // Folder Templates: генерация FSD-модулей для Svelte 5 (руны).
  // Без пустого <style>: компилятор Svelte предупреждает о пустых правилах (css_empty_ruleset).
  // Слои FSD лежат в src/lib (src/routes — роутинг SvelteKit).
  // Вызов: ПКМ по папке в Explorer → «Create New Templated Folder».
  "folderTemplates.fileTemplates": {
    "FSD Svelte: Компонент": [
      "<script lang=\"ts\">",
      "\ttype Props = {",
      "\t\tclass?: string;",
      "\t};",
      "",
      "\tlet { class: className }: Props = $props();",
      "</script>",
      "",
      "<div class={className}></div>"
    ],
    "FSD Svelte: Страница": [
      "<script lang=\"ts\">",
      "\ttype Props = {",
      "\t\tclass?: string;",
      "\t};",
      "",
      "\tlet { class: className }: Props = $props();",
      "</script>",
      "",
      "<main class={className}></main>"
    ],
    "FSD Svelte: Публичный API слайса": [
      "export { default as <FTName | pascalcase> } from \"./ui/<FTName | pascalcase>.svelte\";"
    ],
    "FSD Svelte: Публичный API страницы": [
      "export { default as <FTName | pascalcase>Page } from \"./ui/<FTName | pascalcase>Page.svelte\";"
    ]
  },
  "folderTemplates.structures": [
    {
      "name": "FSD Svelte: Компонент (в сегменте ui)",
      "omitParentDirectory": true,
      "overwriteExistingFiles": "prompt",
      "openFilesWhenDone": ["<FTName | pascalcase>.svelte"],
      "structure": [
        { "fileName": "<FTName | pascalcase>.svelte", "template": "FSD Svelte: Компонент" }
      ]
    },
    {
      "name": "FSD Svelte: Слайс (entities/features/widgets)",
      "omitParentDirectory": true,
      "overwriteExistingFiles": "prompt",
      "openFilesWhenDone": ["<FTName | kebabcase>/ui/<FTName | pascalcase>.svelte"],
      "structure": [
        { "fileName": "<FTName | kebabcase>/index.ts", "template": "FSD Svelte: Публичный API слайса" },
        { "fileName": "<FTName | kebabcase>/ui/<FTName | pascalcase>.svelte", "template": "FSD Svelte: Компонент" }
      ]
    },
    {
      "name": "FSD Svelte: Страница (pages)",
      "omitParentDirectory": true,
      "overwriteExistingFiles": "prompt",
      "openFilesWhenDone": ["<FTName | kebabcase>-page/ui/<FTName | pascalcase>Page.svelte"],
      "structure": [
        { "fileName": "<FTName | kebabcase>-page/index.ts", "template": "FSD Svelte: Публичный API страницы" },
        { "fileName": "<FTName | kebabcase>-page/ui/<FTName | pascalcase>Page.svelte", "template": "FSD Svelte: Страница" }
      ]
    }
  ]
}
